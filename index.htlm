<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Réflexe Rush</title>

<style>
* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #111;
  color: white;
  text-align: center;
  overflow: hidden;
  touch-action: manipulation;
}

#menu {
  height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 20px;
}

h1 {
  font-size: 48px;
  margin: 0 0 15px;
}

p {
  font-size: 20px;
}

button {
  border: none;
  border-radius: 18px;
  padding: 18px 45px;
  font-size: 25px;
  font-weight: bold;
  background: #00c853;
  color: white;
  margin-top: 25px;
}

button:active {
  transform: scale(0.95);
}

#game {
  display: none;
  height: 100vh;
  position: relative;
}

#score {
  position: absolute;
  top: 20px;
  left: 20px;
  font-size: 25px;
  z-index: 5;
}

#best {
  position: absolute;
  top: 55px;
  left: 20px;
  font-size: 18px;
  z-index: 5;
}

#message {
  position: absolute;
  top: 40%;
  width: 100%;
  font-size: 32px;
  font-weight: bold;
  z-index: 5;
}

#zone {
  position: absolute;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: #222;
  border: 6px solid white;
  display: none;
}

#result {
  display: none;
  height: 100vh;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

#result h2 {
  font-size: 40px;
}

#finalScore {
  font-size: 60px;
  font-weight: bold;
}
</style>
</head>

<body>

<!-- MENU -->
<div id="menu">
  <h1>⚡ RÉFLEXE RUSH</h1>
  <p>Touche le cercle dès qu'il apparaît !</p>
  <p>Teste tes réflexes et bats ton record.</p>
  <button id="playButton">JOUER</button>
</div>

<!-- JEU -->
<div id="game">
  <div id="score">Score : 0</div>
  <div id="best">Record : 0</div>
  <div id="message">Prépare-toi...</div>
  <div id="zone"></div>
</div>

<!-- RESULTAT -->
<div id="result">
  <h2>🏁 FIN DE LA PARTIE</h2>
  <div id="finalScore">0</div>
  <p>points</p>
  <button id="restartButton">REJOUER</button>
</div>

<script>
const menu = document.getElementById("menu");
const game = document.getElementById("game");
const result = document.getElementById("result");

const playButton = document.getElementById("playButton");
const restartButton = document.getElementById("restartButton");

const zone = document.getElementById("zone");
const message = document.getElementById("message");

const scoreText = document.getElementById("score");
const bestText = document.getElementById("best");
const finalScore = document.getElementById("finalScore");

let score = 0;
let best = Number(localStorage.getItem("reflexeBest")) || 0;
let waiting = false;
let gameRunning = false;
let timer = null;

bestText.textContent = "Record : " + best;

function startGame() {
  menu.style.display = "none";
  result.style.display = "none";
  game.style.display = "block";

  score = 0;
  gameRunning = true;
  waiting = false;

  scoreText.textContent = "Score : 0";
  message.textContent = "Prépare-toi...";

  zone.style.display = "none";

  setTimeout(showTarget, 1000);
}

function showTarget() {
  if (!gameRunning) return;

  waiting = true;
  message.textContent = "";

  const size = Math.min(130, window.innerWidth * 0.28);

  zone.style.width = size + "px";
  zone.style.height = size + "px";

  const maxX = window.innerWidth - size - 10;
  const maxY = window.innerHeight - size - 10;

  const x = Math.random() * maxX;
  const y = Math.random() * maxY;

  zone.style.left = x + "px";
  zone.style.top = y + "px";
  zone.style.display = "block";

  timer = setTimeout(() => {
    if (waiting) {
      waiting = false;
      endGame();
    }
  }, Math.max(700, 1600 - score * 30));
}

function hitTarget(event) {
  if (event) event.preventDefault();

  if (!gameRunning || !waiting) return;

  waiting = false;

  if (timer) {
    clearTimeout(timer);
  }

  score++;

  scoreText.textContent = "Score : " + score;

  zone.style.display = "none";

  setTimeout(showTarget, Math.max(200, 650 - score * 15));
}

function endGame() {
  gameRunning = false;
  waiting = false;

  if (timer) {
    clearTimeout(timer);
  }

  zone.style.display = "none";

  if (score > best) {
    best = score;
    localStorage.setItem("reflexeBest", best);
  }

  finalScore.textContent = score;
  result.style.display = "flex";
  game.style.display = "none";
  bestText.textContent = "Record : " + best;
}

playButton.addEventListener("click", startGame);
restartButton.addEventListener("click", startGame);

zone.addEventListener("touchstart", hitTarget, { passive: false });
zone.addEventListener("click", hitTarget);

</script>

</body>
</html>